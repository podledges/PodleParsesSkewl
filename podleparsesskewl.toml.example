# Copy to podleparsesskewl.toml in the working directory, or to
# ~/.config/podleparsesskewl/podleparsesskewl.toml
#
# Default on the captain's Windows machine. The path contains spaces; keep the quotes.
lectures_dir = "C:\\Users\\ayden\\Documents\\SCHOOL\\NUS Y3S1"

# Under WSL the Windows path above is translated automatically to
# /mnt/c/Users/ayden/Documents/SCHOOL/NUS Y3S1, so it needs no separate entry.
# You can still name the WSL path directly. Quote it; it contains spaces.
# lectures_dir = "/mnt/c/Users/ayden/Documents/SCHOOL/NUS Y3S1"
#
# An explicitly passed --config file wins over PODLEPARSESSKEWL_*_DIR environment variables.
# Your own podleparsesskewl.toml is git-ignored; only this example is committed.
#
# Optional default parent for Lecture folders. Each run still writes
# <output_dir>/<recording-stem>.lecture. Unset means next to the Recording.
# output_dir = "C:\\Users\\ayden\\Documents\\SCHOOL\\NUS Y3S1\\reviews"
#
# Archive is off by default. Set archive_after_notes to true, or pass --archive,
# to move the Recording and its sidecar into a unique folder under archive_dir
# after notes succeed. --no-archive leaves the Recording in place even when this
# is true. Generated Lecture files stay put.
# archive_dir = "C:\\Users\\ayden\\Documents\\SCHOOL\\NUS Y3S1\\archive"
# archive_after_notes = false
