# Copy to podleparsesskewl.toml in the working directory, or to
# ~/.config/podleparsesskewl/podleparsesskewl.toml
#
# Default on the captain's Windows machine:
lectures_dir = "C:\\Users\\ayden\\Videos\\Lectures"

# Under WSL the Windows path above is translated automatically to
# /mnt/c/Users/ayden/Videos/Lectures, so it needs no separate entry.
# You can still name the WSL path directly:
# lectures_dir = "/mnt/c/Users/ayden/Videos/Lectures"
#
# An explicitly passed --config file wins over PODLEPARSESSKEWL_*_DIR environment variables.
# Your own podleparsesskewl.toml is git-ignored; only this example is committed.
#
# Optional default parent for Lecture folders. Each run still writes
# <output_dir>/<recording-stem>.lecture. Unset means next to the Recording.
# output_dir = "C:\\Users\\ayden\\Videos\\Lectures\\reviews"
#
# After `pps notes` / Parse + Notes succeeds, the Recording is moved (not copied)
# into a unique folder under archive_dir. Generated Lecture files stay put.
# archive_dir = "C:\\Users\\ayden\\Videos\\Lectures\\archive"
# archive_after_notes = true
